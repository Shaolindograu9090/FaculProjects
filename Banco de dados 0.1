CREATE TABLE Escritorio_ad (
    CNPJ VARCHAR(20) PRIMARY KEY,
    Nome_Cidade VARCHAR(100),
    Nome_Rua VARCHAR(100)
);

CREATE TABLE Advogado (
    OAB VARCHAR(20) PRIMARY KEY,
    CPF VARCHAR(14) NOT NULL UNIQUE,
    Telefone VARCHAR(20),
    CNPJ_Escritorio VARCHAR(20),
    FOREIGN KEY (CNPJ_Escritorio) REFERENCES Escritorio_ad(CNPJ)
);

CREATE TABLE Cliente (
    CPF VARCHAR(14) PRIMARY KEY,
    Nome_cl VARCHAR(100) NOT NULL,
    Telefone VARCHAR(20)
);

CREATE TABLE Juiz (
    Vara_Judicial VARCHAR(50) PRIMARY KEY,
    Nome VARCHAR(100)
);

CREATE TABLE Processo (
    Cod_Processo INT PRIMARY KEY,
    Autos_processo VARCHAR(255),
    Tipo_Processo VARCHAR(50),
    CPF_Cliente VARCHAR(14) NOT NULL,
    Vara_Juiz_Julgador VARCHAR(50) NOT NULL,
    FOREIGN KEY (CPF_Cliente) REFERENCES Cliente(CPF),
    FOREIGN KEY (Vara_Juiz_Julgador) REFERENCES Juiz(Vara_Judicial)
);

CREATE TABLE Sentenca (
    ID_Processo INT PRIMARY KEY,
    Result_merito VARCHAR(255),
    Juiz_Prolador_Nome VARCHAR(100),
    Vara_Juiz_Autor VARCHAR(50),
    FOREIGN KEY (ID_Processo) REFERENCES Processo(Cod_Processo),
    FOREIGN KEY (Vara_Juiz_Autor) REFERENCES Juiz(Vara_Judicial)
);

CREATE TABLE Defende (
    OAB_Advogado VARCHAR(20),
    CPF_Cliente VARCHAR(14),
    PRIMARY KEY (OAB_Advogado, CPF_Cliente),
    FOREIGN KEY (OAB_Advogado) REFERENCES Advogado(OAB),
    FOREIGN KEY (CPF_Cliente) REFERENCES Cliente(CPF)
);


