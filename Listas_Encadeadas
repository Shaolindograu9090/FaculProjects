#include <iostream>
#include <string>

using namespace std;

struct Node {
    int valor;
    Node* proximo;
};

void inserirFim(Node*& inicio, int valor) {
    Node* novoNode = new Node();
    novoNode->valor = valor;
    novoNode->proximo = nullptr;
    
    if (inicio == nullptr) {
        inicio = novoNode;
    } else {
        Node* atual = inicio;
        while (atual->proximo != nullptr) {
            atual = atual->proximo;
        }
        atual->proximo = novoNode;
    }
}


