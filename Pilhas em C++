#include <iostream>
#include <stack>
#include <string>

using namespace std;

int main() {
    stack<string> pilha;
    int opcao;
    string acao;

    do {
        cout << "\n1 - Registrar acao" << endl;
        cout << "2 - Desfazer ultima acao" << endl;
        cout << "3 - Mostrar ultima acao" << endl;
        cout << "4 - Mostrar historico" << endl;
        cout << "0 - Sair" << endl;
        cout << "Escolha: ";
        cin >> opcao;

        if (opcao == 1) {
            cout << "Digite a acao: ";
            cin.ignore();
            getline(cin, acao);

            pilha.push(acao);

            cout << "Acao registrada." << endl;
        }

        else if (opcao == 2) {
            if (pilha.empty()) {
                cout << "Nao existem acoes para desfazer." << endl;
            } else {
                cout << "Desfeito: " << pilha.top() << endl;
                pilha.pop();
            }
        }

        else if (opcao == 3) {
            if (pilha.empty()) {
                cout << "Nao existem acoes." << endl;
            } else {
                cout << "Ultima acao: " << pilha.top() << endl;
            }
        }

        else if (opcao == 4) {
            if (pilha.empty()) {
                cout << "Historico vazio." << endl;
            } else {
                stack<string> copia = pilha;

                cout << "Historico:" << endl;

                while (!copia.empty()) {
                    cout << copia.top() << endl;
                    copia.pop();
                }
            }
        }

    } while (opcao != 0);

    return 0;
}



