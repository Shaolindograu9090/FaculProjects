#include <iostream>
#include <stack>
#include <string>

using namespace std;

int main() {
    string expressao;
    stack<char> pilha;
    bool valido = true;

    cout << "Digite a expressao: ";
    getline(cin, expressao);

    for (int i = 0; i < expressao.length(); i++) {
        char c = expressao[i];

        if (c == '(' || c == '[' || c == '{') {
            pilha.push(c);
        }

        else if (c == ')' || c == ']' || c == '}') {
            if (pilha.empty()) {
                valido = false;
                break;
            }

            char topo = pilha.top();

            if (c == ')' && topo != '(') {
                valido = false;
                break;
            }

            if (c == ']' && topo != '[') {
                valido = false;
                break;
            }

            if (c == '}' && topo != '{') {
                valido = false;
                break;
            }

            pilha.pop();
        }
    }

    if (!pilha.empty()) {
        valido = false;
    }

    if (valido) {
        cout << "Expressao valida." << endl;
    } else {
        cout << "Expressao invalida." << endl;
    }

    return 0;
}




