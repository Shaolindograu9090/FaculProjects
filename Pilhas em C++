#include <iostream>
#include <stack>
#include <string>

using namespace std;

int main() {
    string palavra;
    stack<char> pilha;

    cout << "Digite uma palavra aleatoria: ";
    cin >> palavra;

    for (int i = 0; i < palavra.length(); i++) {
        pilha.push(palavra[i]);
    }

    string invertida = "";

    while (!pilha.empty()) {
        invertida += pilha.top();
        pilha.pop();
    }

    if (palavra == invertida) {
        cout << "E palindromo." << endl;
    } else {
        cout << "Nao e palindromo." << endl;
    }

    return 0;
}


