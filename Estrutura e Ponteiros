#include <iostream>
#include <string>

using namespace std;

struct produto {
    string nome;
    double preco;
    int codigo;
};

// A função deve ser declarada fora da main
void Ajustar(produto *p, double percentual) {
    if (p != nullptr) {
        p->preco += p->preco * (percentual / 100.0);
    }
}

int main() {

    produto meuProduto = {"Caderno", 10.0, 101};

    cout << "Preco antigo: R$ " << meuProduto.preco << endl;

    Ajustar(&meuProduto, 10.0);

    cout << "Novo preco (com +10%): R$ " << meuProduto.preco << endl;

    return 0;
}


