#include <iostream>
#include <string>
#include <iomanip>

using namespace std;

struct Turma {
    string nome;
    int quantidade;
    double* notas;
};

double calcularMedia(const Turma* t) {
    double soma = 0;
    for (int i = 0; i < t->quantidade; ++i) {
        soma += t->notas[i];
    }
    return soma / t->quantidade;
}

int main() {
    Turma* t = new Turma;
    if (!(cin >> t->nome >> t->quantidade)) {
        delete t;
        return 0;
    }

    t->notas = new double[t->quantidade];
    for (int i = 0; i < t->quantidade; ++i) {
        cin >> t->notas[i];
    }
cout << fixed << setprecision(2);
cout << t->nome << "\n";
for (int i = 0; i < t->quantidade; ++i) {
    cout << t->notas[i] << (i == t->quantidade - 1 ? "" : " ");
}
cout << "\n";
cout << calcularMedia(t) << "\n";

delete[] t->notas;
delete t;
return 0;
}



